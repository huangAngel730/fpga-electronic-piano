<?xml version="1" encoding="UTF-8"?>
<!DOCTYPE gowin-fpga-project>
<!--
  electronic_piano.gprj
  实时多音色合成电子乐器引擎（高云选题二）—— Gowin 工程文件

  板卡：Sipeed Tang Mega 60K 核心板 30354 + NEO Dock 31005
  器件：GW5AT-LV60PG484AC1/I0（器件名 GW5AT-60B）

  器件三要素的来源不是猜测，而是本机 Gowin 教育版 V1.9.11.03 自带的
  器件数据库，可用 device_package.csv 复核：
    gw5at60b-002,GW5AT-LV60PG484AC1/I0,GW5AT,GW5AT-60B,PBGA484A,...
  该行同时给出 pn 与封装。

  【封装写法定案（D018 第 2 项，已关闭）】
  IDE 中应选择的封装名为 **PBG484A**，Device Version 为 **B**。
  依据 Sipeed 官方 Wiki 的 Precautions 表原文：
    "The specific model of the FPGA chip used by Tang Mega 60K is
     GW5AT-LV60PG484A. Please select the package model PBG484A &
     Device Version: B in the IDE."
  即料号段写作 PG484A、IDE 封装名写作 PBG484A，两者是不同层级的写法，
  **均非笔误**。

  【注意】上面 device_package.csv 行里的 PBGA484A 是器件数据库的**内部**
  封装名，与 IDE 呈现给用户的封装名可以不同，**不得据它否定 PBG484A**。
  本文件曾一度据此把结论改成 PBGA484A，属无效推理，已改回（见 V0032）。
  本行的 <Device> 索引 gw5at60b-002 才是实际生效的器件选择。

  源文件用相对路径引用，因此本工程可整体移动；
  指向的 RTL 与约束仍存放在 code/rtl 与 code/constraints，不在本目录复制一份，
  避免同一份源码出现两个副本后失去同步。
-->
<Project>
    <Template>FPGA</Template>
    <Version>5</Version>
    <Device name="GW5AT-60B" pn="GW5AT-LV60PG484AC1/I0">gw5at60b-002</Device>
    <FileList>
        <!-- 顶层：最小可上板工程，见文件头说明 -->
        <File path="../rtl/board/electronic_piano_top.sv" type="file.verilog" enable="1"/>
        <!-- 公共模块与定义包 -->
        <File path="../rtl/common/audio_defs_pkg.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/common/reset_sync.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/common/sample_tick_gen.sv" type="file.verilog" enable="1"/>
        <!-- T021 按键去抖（M3 实现，方案 A 于 2026-09-15 替换 M2 的占位版）
             2026-09-15 布局迁移：rtl/input/ 改为每模块一子目录 -->
        <File path="../rtl/input/button_debouncer/button_debouncer.sv" type="file.verilog" enable="1"/>
        <!-- T022 按键转统一演奏事件（M3 实现，2026-09-15 按 D022 取代 M2 占位
             key_event_source.sv；事件类型同时收敛到 audio_defs_pkg.sv，
             perf_event_pkg.sv 已删除） -->
        <File path="../rtl/input/button_event_converter/button_event_converter.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/common/note_pitch.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/common/simple_voice.sv" type="file.verilog" enable="1"/>
        <!-- I2S LSBJ 发送器 -->
        <File path="../rtl/audio_out/i2s_tx.sv" type="file.verilog" enable="1"/>
        <!-- 引脚约束（9 脚，见 electronic_piano.cst 头部说明） -->
        <File path="../constraints/electronic_piano.cst" type="file.cst" enable="1"/>
        <!-- 时序约束（50 MHz + I2S 虚拟时钟 + 输出延迟） -->
        <File path="../constraints/audio_timing.sdc" type="file.sdc" enable="1"/>
    </FileList>
</Project>
