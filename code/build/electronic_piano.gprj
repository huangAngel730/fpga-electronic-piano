<?xml version="1" encoding="UTF-8"?>
<!DOCTYPE gowin-fpga-project>
<!--
  electronic_piano.gprj
  实时多音色合成电子乐器引擎（高云选题二）—— Gowin 工程文件

  板卡：Sipeed Tang Mega 60K 核心板 30354 + NEO Dock 31005
  器件：GW5AT-LV60PG484AC1/I0（器件名 GW5AT-60B，封装 PBGA484A）

  器件三要素的来源不是猜测，而是本机 Gowin 教育版 V1.9.11.03 自带的
  器件数据库，可用 device_package.csv 复核：
    gw5at60b-002,GW5AT-LV60PG484AC1/I0,GW5AT,GW5AT-60B,PBGA484A,...
  该行同时给出 pn 与封装，故 D018 的
  "PBG484A vs PG484A" 之争到此结束：
    - pn   = GW5AT-LV60PG484AC1/I0   （PG484A 是 pn 里的封装代码段）
    - 封装 = PBGA484A                （P-BGA，塑封球栅阵列）
  此前仓库把封装误写作 "PBG484A"（字母顺序颠倒），已更正。

  源文件用相对路径引用，因此本工程可整体移动；
  指向的 RTL 与约束仍存放在 code/rtl 与 code/constraints，不在本目录复制一份，
  避免同一份源码出现两个副本后失去同步。
-->
<Project>
    <Template>FPGA</Template>
    <Version>5</Version>
    <Device name="GW5AT-60B" pn="GW5AT-LV60PG484AC1/I0">gw5at60b-002</Device>
    <FileList>
        <!-- 顶层：最小可上板工程，见文件头说明 -->
        <File path="../rtl/board/electronic_piano_top.sv" type="file.verilog" enable="1"/>
        <!-- 公共模块与定义包 -->
        <File path="../rtl/common/audio_defs_pkg.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/common/reset_sync.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/common/sample_tick_gen.sv" type="file.verilog" enable="1"/>
        <!-- I2S LSBJ 发送器 -->
        <File path="../rtl/audio_out/i2s_tx.sv" type="file.verilog" enable="1"/>
        <!-- 引脚约束（7 脚，见 electronic_piano.cst 头部说明） -->
        <File path="../constraints/electronic_piano.cst" type="file.cst" enable="1"/>
        <!-- 时序约束（50 MHz + I2S 虚拟时钟 + 输出延迟） -->
        <File path="../constraints/audio_timing.sdc" type="file.sdc" enable="1"/>
    </FileList>
</Project>
