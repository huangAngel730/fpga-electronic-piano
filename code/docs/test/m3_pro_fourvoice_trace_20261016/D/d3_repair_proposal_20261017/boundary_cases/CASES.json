  "expansion_contract": {
    "steps": [
      "Resolve the named calendar profile independently; do not derive frames/deadlines from observed trace rows.",
      "Concatenate prefix_fragments in listed order, then suffix_rows without sorting equal-cycle rows.",
      "Bind the case horizon_cycle and any independent_reset to the frozen driver calendar before emitting a trace.",
      "For reset cases the old epoch calendar is required through reset_cycle inclusively; later old frames are suppressed only because that reset was independently planned.",
      "The new epoch first_frame_cycle is explicitly supplied and lies after the case horizon; it is not inferred from the first observed FRAME.",
      "The old V1 manifest/calendar/CLI cannot ingest this wrapper. M2 must approve an adapter/schema, exact source/artifact identities and execution budget first."
    ],
    "fixture_clock_hz": 40000000,
    "not_a_claim": "No real Pro frame phase, PCM golden, actual 48kHz or observed CLI acceptance is claimed.",
    "same_cycle_policy_proposal": {
      "frame_before_consume_for_due_request": true,
      "frame_before_request_at_that_frame": true,
      "consume_old_vs_request_new": "Either listed order is retained for distinct IDs; both are permitted by the old D3 state transitions. M2 may change this only with an explicit sampling contract.",
      "missing_FRAME_check": "Before advancing past a scheduled cycle, or closing that cycle via END/RESET; do not reject an ordinary same-cycle row merely because a later FRAME/CONSUME row in that group has not yet been read.",
      "CANCEL_check": "Immediately require CANCEL.cycle < independently bound request.deadline_cycle, even before a same-cycle FRAME row.",
      "RESET_check": "Validate old-epoch due FRAME and transactions before epoch mutation; only a planned reset strictly before an open request deadline may cancel it.",
      "END_check": "Close independent calendar obligations through the bound horizon before terminal-ledger acceptance; canceled transactions do not erase frame obligations."
    },
    "diagnostics_are_proposals_not_actual_CLI_strings": true,
    "first_reject_priority_for_these_cases": [
      "Existing manifest/field/order/identity prerequisites are assumed valid, not executed here.",
      "P_MISSING_SCHEDULED_FRAME before processing a later-cycle row, or before END/RESET closes an unmet scheduled cycle.",
      "P_CANCEL_NOT_STRICTLY_BEFORE_DEADLINE at a CANCEL on the deadline cycle, irrespective of FRAME ordering.",
      "Existing per-transaction state and same-cycle consumption rules remain in force; acceptance occurs only after all groups close."
    ]
  },
