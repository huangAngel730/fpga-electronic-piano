    "pattern": "u_i2s_tx|buffered_left|buffered_right|frame_tick|pa_en",
    "matches": [
      {
        "line": 30,
        "text": "// 【上电爆音防护】pa_en 低有效是本设计最关键的板级要求"
      },
      {
        "line": 35,
        "text": "//   本实现把 pa_en 直接由复位信号驱动，**不经过任何时钟域**："
      },
      {
        "line": 36,
        "text": "//     assign pa_en = ~rst_sync_n;   // 复位期间 rst_sync_n=0 -> pa_en=1 -> 功放关"
      },
      {
        "line": 39,
        "text": "//     如果写成 always_ff 里 `if (!rst_n) pa_en <= 1'b1;`，那么在 FPGA 完成"
      },
      {
        "line": 40,
        "text": "//     配置、时钟尚未稳定、复位尚未释放的这段时间里，pa_en 的实际电平取决于"
      },
      {
        "line": 44,
        "text": "//   代价：pa_en 与 rst_sync_n 之间是组合路径，会进入时序分析。"
      },
      {
        "line": 46,
        "text": "//   由于 rst_sync_n 是寄存器输出、pa_en 是直接输出到 IO，路径极短，"
      },
      {
        "line": 74,
        "text": "//   pa_en    AB16 LVCMOS33 3.3 V  Bank 7  功放使能，低有效"
      },
      {
        "line": 92,
        "text": "//     复位期间 pa_en 必须为 1、复位释放后 I2S 输出、正弦音频率与幅度、"
      },
      {
        "line": 149,
        "text": "    //   若把它也当音符键，按下时等于按住复位；而 pa_en = ~rst_sync_n，"
      },
      {
        "line": 159,
        "text": "    output logic pa_en,       // AB16, 低有效：0=开，1=关"
      },
      {
        "line": 354,
        "text": "    assign pa_en = ~rst_sync_n;"
      },
      {
        "line": 359,
        "text": "    logic sample_tick, frame_sample_req, i2s_frame_tick;"
      },
      {
        "line": 364,
        "text": "    logic signed [PCM_WIDTH-1:0] buffered_left, buffered_right;"
      },
      {
        "line": 551,
        "text": "        end else if (i2s_frame_tick || (pcm_valid_q && pcm_ready)) begin"
      },
      {
        "line": 559,
        "text": "        .frame_tick(i2s_frame_tick),"
      },
      {
        "line": 560,
        "text": "        .calc_ready(!pcm_valid_q || i2s_frame_tick),"
      },
      {
        "line": 565,
        "text": "        .play_left(buffered_left), .play_right(buffered_right),"
      },
      {
        "line": 579,
        "text": "          .event_ready(shared_event_ready),.event_data(shared_event_data),.frame_tick(i2s_frame_tick),"
      },
      {
        "line": 580,
        "text": "          .play_left(buffered_left),.play_right(buffered_right),.pending_valid(pending_valid),"
      },
      {
        "line": 611,
        "text": "    ) u_i2s_tx ("
      },
      {
        "line": 615,
        "text": "        .pcm_left  (buffered_left),"
      },
      {
        "line": 616,
        "text": "        .pcm_right (buffered_right),"
      },
      {
        "line": 621,
        "text": "        .frame_tick(i2s_frame_tick)"
      }
    ]
  },
