      },
      {
        "line": 249,
        "text": "        next_right = round_saturate(pcm_right);"
      },
      {
        "line": 297,
        "text": "                // 【曾经的事故】原实现写 `if (frame_start) lrck <= ~lrck;`，"
      },
      {
        "line": 321,
        "text": "    // port is not PCM ready. frame_tick marks a complete 64-BCLK frame."
      },
      {
        "line": 327,
        "text": "        end else if (frame_start && valid) begin"
      },
      {
        "line": 328,
        "text": "            sample_left  <= next_left;"
      },
      {
        "line": 329,
        "text": "            sample_right <= next_right;"
      }
    ]
