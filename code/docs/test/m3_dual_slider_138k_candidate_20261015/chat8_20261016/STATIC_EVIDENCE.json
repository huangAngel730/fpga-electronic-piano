  "zip_members": {
    "inputs/sources/audio_visual_display_probe.sv": {
      "bytes": 7018,
      "sha256": "df1f05b4a6a06deddd9d3a2244106ec29bb0d15e5dd808fc9bef9436d710a5cf",
      "lines": {
        "1": "// M2 display companion for a frozen V1+CC64 audio diagnostic copy.",
        "2": "// Audio-accepted events are copied without backpressure. Diagnostic score and",
        "3": "// automatic mode alternation are not a final UI or downloaded song.",
        "4": "`timescale 1ns/1ps",
        "5": "module audio_visual_display_probe #(",
        "6": "    parameter integer SYS_CLK_HZ = 40_000_000,",
        "7": "    parameter integer MODE_PERIOD_CYCLES = SYS_CLK_HZ * 5,",
        "8": "    parameter integer VIDEO_FRAME_SYS_CYCLES = (SYS_CLK_HZ / 25_000) * 420,",
        "9": "    parameter integer DIAG_SCORE_SPACING_FRAMES = 30",
        "10": ") (",
        "11": "    input logic sys_clk,sys_rst_n,",
        "12": "    input wire ref_clk,",
        "13": "    output wire core_clk,",
        "14": "    input logic accepted_valid,",
        "15": "    input audio_defs_pkg::performance_event_t accepted_data,",
        "16": "    output wire tmds_clk_p,tmds_clk_n,",
        "17": "    output wire [2:0] tmds_data_p,tmds_data_n,",
        "18": "    output wire visual_pll_locked",
        "19": ");",
        "20": "    import audio_defs_pkg::*;",
        "21": "    wire serial_clk,pixel_clk,pll_lock,serial_rst_n;",
        "22": "    wire visual_rst_n = sys_rst_n && pll_lock;",
        "23": "    wire sys_reset_done,video_reset_done;",
        "24": "    wire [15:0] pixel_x,pixel_y;",
        "25": "    wire hs,vs,de,frame_start,line_start;",
        "26": "    wire video_valid,video_desync,video_ready;",
        "27": "    wire [15:0] queue_level,queue_peak;",
        "28": "    wire [31:0] drop_count;",
        "29": "    wire drop_pulse,score_ready,display_mode;",
        "30": "    wire control_sys_done,control_video_done;",
        "31": "    wire src_score_ready,src_mode_ready;",
        "32": "    wire video_score_valid,video_mode_pulse;",
        "33": "    wire [15:0] video_score_note_id;",
        "34": "    wire [6:0] video_score_note_number;",
        "35": "    wire [31:0] video_score_hit_frame,video_score_duration_frames;",
        "36": "    wire video_score_duration_valid;",
        "37": "    wire [9:0] video_score_velocity;",
        "38": "    logic [15:0] score_seq;",
        "39": "    logic mode_pending, score_pending;",
        "40": "    logic [31:0] diag_frame,diag_frame_cycles,score_due_frame,diag_hit_frame;",
        "41": "    wire [31:0] current_frame;",
        "42": "    wire [7:0] rgb_r,rgb_g,rgb_b;",
        "43": "    performance_event_t video_data;",
        "44": "    logic [31:0] sys_count;",
        "45": "    always_ff @(posedge sys_clk or negedge visual_rst_n) begin",
        "46": "        if (!visual_rst_n) begin",
        "47": "            sys_count <= 0; score_seq <= 0; mode_pending <= 0;",
        "48": "            score_pending<=0;diag_frame<=0;diag_frame_cycles<=0;score_due_frame<=0;diag_hit_frame<=120;",
        "49": "        end else begin",
        "50": "            if (sys_count == MODE_PERIOD_CYCLES-1) begin",
        "51": "                sys_count <= 0;",
        "52": "                mode_pending <= 1;",
        "53": "            end else sys_count <= sys_count + 1'b1;",
        "54": "            // 800*525 pixels at25MHz =16.8ms, i.e.672000 cycles at40MHz.",
        "55": "            // Preserve wall-clock frame time; no pixel bus CDC read.",
        "56": "            // Frame-reset release differs by a few cycles (<one frame).",
        "57": "            if(diag_frame_cycles==VIDEO_FRAME_SYS_CYCLES-1)begin",
        "58": "                diag_frame_cycles<=0;diag_frame<=diag_frame+1'b1;",
        "59": "            end else diag_frame_cycles<=diag_frame_cycles+1'b1;",
        "60": "            if(!score_pending && control_sys_done && diag_frame>=score_due_frame)begin",
        "61": "                score_pending<=1;diag_hit_frame<=diag_frame+32'd120;",
        "62": "            end",
        "63": "            if(score_pending && src_score_ready && control_sys_done)begin",
        "64": "                score_pending<=0;score_seq<=score_seq+1'b1;",
        "65": "                score_due_frame<=diag_frame+DIAG_SCORE_SPACING_FRAMES;",
        "66": "            end",
        "67": "            if (mode_pending && src_mode_ready) mode_pending <= 0;",
        "68": "        end",
        "69": "    end",
        "70": "    TMDS_PLL u_video_pll(.clkin(ref_clk),.lock(pll_lock),.clkout0(serial_clk),",
        "71": "        .clkout1(pixel_clk),.clkout2(core_clk));",
        "72": "    reset_sync u_serial_reset(.clk(serial_clk),.rst_n(visual_rst_n),.rst_sync_n(serial_rst_n));",
        "73": "    visual_event_bridge #(.DEPTH(32)) u_event_bridge(",
        "74": "        .sys_clk(sys_clk),.video_clk(pixel_clk),.rst_n(visual_rst_n),",
        "75": "        .accepted_valid(accepted_valid),.accepted_data(accepted_data),",
        "76": "        .visual_queue_level(queue_level),.visual_queue_high_watermark(queue_peak),",
        "77": "        .visual_drop_count(drop_count),.visual_drop_pulse(drop_pulse),",
        "78": "        .sys_reset_done(sys_reset_done),.video_reset_done(video_reset_done),",
        "79": "        .video_valid(video_valid),.video_desync(video_desync),",
        "80": "        .video_ready(video_ready),.video_data(video_data));",
        "81": "    visual_control_bridge u_control (",
        "82": "        .sys_clk(sys_clk), .pixel_clk(pixel_clk), .rst_n(visual_rst_n),",
        "83": "        .src_mode_valid(mode_pending), .src_mode_ready(src_mode_ready),",
        "84": "        .video_mode_toggle_pulse(video_mode_pulse),",
        "85": "        .src_score_valid(score_pending && control_sys_done), .src_score_ready(src_score_ready),",
        "86": "        .src_score_note_id(score_seq),",
        "87": "        .src_score_note_number(7'd60+{4'd0,score_seq[2:0]}),",
        "88": "        .src_score_hit_frame(diag_hit_frame),",
        "89": "        .src_score_duration_valid(score_seq[0]),",
        "90": "        .src_score_duration_frames(32'd30), .src_score_velocity(10'd600),",
        "91": "        .video_score_valid(video_score_valid), .video_score_ready(score_ready),",
        "92": "        .video_score_note_id(video_score_note_id),",
        "93": "        .video_score_note_number(video_score_note_number),",
        "94": "        .video_score_hit_frame(video_score_hit_frame),",
        "95": "        .video_score_duration_valid(video_score_duration_valid),",
        "96": "        .video_score_duration_frames(video_score_duration_frames),",
        "97": "        .video_score_velocity(video_score_velocity),",
        "98": "        .sys_reset_done(control_sys_done), .video_reset_done(control_video_done)",
        "99": "    );",
        "100": "    video_scan_timing u_scan(.pixel_clk(pixel_clk),.rst_n(video_reset_done && control_video_done),",
        "101": "        .pixel_x(pixel_x),.pixel_y(pixel_y),.data_enable(de),",
        "102": "        .hsync(hs),.vsync(vs),.frame_start(frame_start),.line_start(line_start));",
        "103": "    m3_visualizer u_scene(",
        "104": "        .pixel_clk(pixel_clk),.video_rst_n(video_reset_done && control_video_done),",
        "105": "        .pixel_x(pixel_x),.pixel_y(pixel_y),.data_enable(de),",
        "106": "        .frame_start(frame_start),.event_valid(video_valid),",
        "107": "        .event_data(video_data),.event_ready(video_ready),",
        "108": "        .video_desync(video_desync),",
        "109": "        .mode_toggle_pulse(video_mode_pulse),",
        "110": "        .score_valid(video_score_valid), .score_ready(score_ready),",
        "111": "        .score_note_id(video_score_note_id),",
        "112": "        .score_note_number(video_score_note_number),",
        "113": "        .score_hit_frame(video_score_hit_frame),",
        "114": "        .score_duration_valid(video_score_duration_valid),",
        "115": "        .score_duration_frames(video_score_duration_frames),",
        "116": "        .score_velocity(video_score_velocity),",
        "117": "        .display_mode(display_mode),.current_frame(current_frame),",
        "118": "        .rgb_r(rgb_r),.rgb_g(rgb_g),.rgb_b(rgb_b));",
        "119": "    logic dvi_hs,dvi_vs,dvi_de;",
        "120": "    logic [7:0] dvi_r,dvi_g,dvi_b;",
        "121": "    always_ff @(posedge pixel_clk or negedge video_reset_done) begin",
        "122": "        if(!video_reset_done) begin",
        "123": "            dvi_hs<=1'b1; dvi_vs<=1'b1; dvi_de<=1'b0;",
        "124": "            dvi_r<='0; dvi_g<='0; dvi_b<='0;",
        "125": "        end else begin",
        "126": "            dvi_hs<=hs; dvi_vs<=vs; dvi_de<=de;",
        "127": "            dvi_r<=rgb_r; dvi_g<=rgb_g; dvi_b<=rgb_b;",
        "128": "        end",
        "129": "    end",
        "130": "    DVI_TX_Top u_video_tx(.I_rst_n(serial_rst_n),.I_serial_clk(serial_clk),",
        "131": "        .I_rgb_clk(pixel_clk),.I_rgb_vs(dvi_vs),.I_rgb_hs(dvi_hs),.I_rgb_de(dvi_de),",
        "132": "        .I_rgb_r(dvi_r),.I_rgb_g(dvi_g),.I_rgb_b(dvi_b),",
        "133": "        .O_tmds_clk_p(tmds_clk_p),.O_tmds_clk_n(tmds_clk_n),",
        "134": "        .O_tmds_data_p(tmds_data_p),.O_tmds_data_n(tmds_data_n));",
        "135": "    assign visual_pll_locked=pll_lock;",
        "136": "endmodule"
      }
    },
    "inputs/sources/m2_fourvoice_timbre_delay_board_top.sv": {
      "bytes": 37390,
      "sha256": "f2a8f30fef8ad2da26d1d3b80793b727f45806b6d5c78f2a071fb383322639be",
      "lines": {
        "670": "    // -------------------------------------------------------------------------",
        "671": "    // 未使用的信号，显式标注避免 lint 警告",
        "672": "    // -------------------------------------------------------------------------",
        "673": "    logic unused_ok;",
        "674": "    assign unused_ok = i2s_ready;",
        "675": "",
        "676": "",
        "677": "    // Display-only copy of events already accepted by the current audio core.",
        "678": "    // Same accepted-event CDC contract, but its source domain is now40MHz.",
        "679": "    audio_visual_display_probe #(.SYS_CLK_HZ(CLK_HZ)) u_visual (",
        "680": "        .sys_clk(core_clk),.sys_rst_n(sys_rst_n),.ref_clk(sys_clk),.core_clk(core_clk),",
        "681": "        .accepted_valid(shared_event_valid && shared_event_ready),",
        "682": "        .accepted_data(shared_event_data),",
        "683": "        .tmds_clk_p(tmds_clk_p),.tmds_clk_n(tmds_clk_n),",
        "684": "        .tmds_data_p(tmds_data_p),.tmds_data_n(tmds_data_n),",
        "685": "        .visual_pll_locked(visual_pll_locked)",
        "686": "    );",
        "687": "",
        "688": "endmodule",
        "689": "",
        "690": "`endif  // M2_FOURVOICE_TIMBRE_DELAY_TOP_SV"
      }
    },
    "inputs/sources/video_scan_timing.sv": {
      "bytes": 1953,
      "sha256": "0b7b3def84043ddd40ed2c1e237bb2d528a117e4fc15195d40b33b0fe78b2069",
      "lines": {
        "1": "// M2 parameterized raster timing. No PLL, TMDS encoder, pixel renderer or pins.",
        "2": "// Defaults describe candidate 640x480 geometry only, NOT a frozen HDMI mode.",
        "3": "// Input pixel_clk is an actual clock; rst_n is already synchronized to it.",
        "4": "`timescale 1ns/1ps",
        "5": "module video_scan_timing #(",
        "6": "    parameter integer H_ACTIVE = 640, H_FRONT = 16, H_SYNC = 96, H_BACK = 48,",
        "7": "    parameter integer V_ACTIVE = 480, V_FRONT = 10, V_SYNC = 2, V_BACK = 33,",
        "8": "    parameter bit H_POLARITY = 1'b0, V_POLARITY = 1'b0",
        "9": ") (",
        "10": "    input logic pixel_clk, rst_n,",
        "11": "    output logic [15:0] pixel_x, pixel_y,",
        "12": "    output logic data_enable, hsync, vsync, frame_start, line_start",
        "13": ");",
        "14": "    localparam integer H_TOTAL = H_ACTIVE + H_FRONT + H_SYNC + H_BACK;",
        "15": "    localparam integer V_TOTAL = V_ACTIVE + V_FRONT + V_SYNC + V_BACK;",
        "16": "    always_ff @(posedge pixel_clk or negedge rst_n) begin",
        "17": "        if (!rst_n) begin",
        "18": "            pixel_x <= '0;",
        "19": "            pixel_y <= '0;",
        "20": "        end else if (pixel_x == H_TOTAL-1) begin",
        "21": "            pixel_x <= '0;",
        "22": "            if (pixel_y == V_TOTAL-1) pixel_y <= '0;",
        "23": "            else pixel_y <= pixel_y + 1'b1;",
        "24": "        end else pixel_x <= pixel_x + 1'b1;",
        "25": "    end",
        "26": "    always_comb begin",
        "27": "        data_enable = rst_n && pixel_x < H_ACTIVE && pixel_y < V_ACTIVE;",
        "28": "        hsync = !H_POLARITY;",
        "29": "        vsync = !V_POLARITY;",
        "30": "        if (rst_n && pixel_x >= H_ACTIVE + H_FRONT &&",
        "31": "            pixel_x < H_ACTIVE + H_FRONT + H_SYNC) hsync = H_POLARITY;",
        "32": "        if (rst_n && pixel_y >= V_ACTIVE + V_FRONT &&",
        "33": "            pixel_y < V_ACTIVE + V_FRONT + V_SYNC) vsync = V_POLARITY;",
        "34": "        line_start = rst_n && pixel_x == 0;",
        "35": "        frame_start = line_start && pixel_y == 0;",
        "36": "    end",
        "37": "`ifndef SYNTHESIS",
