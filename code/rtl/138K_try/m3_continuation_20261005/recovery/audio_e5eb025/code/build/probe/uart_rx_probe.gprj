<?xml version="1" encoding="UTF-8"?>
<!DOCTYPE gowin-fpga-project>
<!--
  uart_rx_probe.gprj
  UART RX 引脚诊断工程 —— Gowin 工程文件

  板卡：Sipeed Tang Mega 60K 核心板 30354 + NEO Dock 31005
  器件：GW5AT-LV60PG484AC1/I0（器件名 GW5AT-60B）
  器件三要素与 electronic_piano.gprj 完全一致，来源见该文件头部。

  【为什么要单独一个工程，而不是加进 electronic_piano.gprj】
  一个 Gowin 工程只有一个顶层。诊断工程的顶层是 uart_rx_probe，
  正式工程是 electronic_piano_top，两者无法共存在同一个 .gprj 里。
  把诊断代码塞进正式工程会让正式工程的器件资源和时序报告被污染，
  而正式工程的资源与 Fmax 是要写进竞赛材料的证据，不能被诊断代码搅动。

  【为什么放在 build/probe/ 子目录】
  Gowin 把综合与布局布线的中间文件和报告写在 .gprj 同级的 impl/ 目录下，
  其中 cmd.do、device.cfg 这类文件名不带工程名前缀。两个工程若共用
  code/build/impl/，跑诊断就会覆盖正式工程的这些中间文件。
  本工程放在 code/build/probe/ 下，impl/ 随之落在
  code/build/probe/impl/，与正式工程完全隔离。
  .gitignore 里的 **/impl/ 已经覆盖该目录，构建产物不会被提交。

  源文件用相对路径引用，指向 code/rtl 与 code/constraints，不在本目录复制副本。
-->
<Project>
    <Template>FPGA</Template>
    <Version>5</Version>
    <Device name="GW5AT-60B" pn="GW5AT-LV60PG484AC1/I0">gw5at60b-002</Device>
    <FileList>
        <!-- 顶层：诊断工程，只做 UART 接收与报告，不发声 -->
        <File path="../../rtl/board/uart_rx_probe.sv" type="file.verilog" enable="1"/>
        <!-- 被测模块：参数化 UART 接收器，与正式工程将来复用同一份 -->
        <File path="../../rtl/common/uart_rx.sv" type="file.verilog" enable="1"/>
        <!-- 报告发射用：参数化 UART 发送器（uart_rx_probe 内部例化 u_tx） -->
        <File path="../../rtl/common/uart_tx.sv" type="file.verilog" enable="1"/>
        <!-- 复位同步（uart_rx_probe 内部例化） -->
        <File path="../../rtl/common/reset_sync.sv" type="file.verilog" enable="1"/>
        <!-- 引脚约束：10 脚，含 V14 / Y14 两只 RX 候选，见文件头说明 -->
        <File path="../../constraints/uart_rx_probe.cst" type="file.cst" enable="1"/>
        <!-- 时序约束：只有一个 50 MHz create_clock，见文件头说明 -->
        <File path="../../constraints/uart_rx_probe.sdc" type="file.sdc" enable="1"/>
    </FileList>
</Project>
