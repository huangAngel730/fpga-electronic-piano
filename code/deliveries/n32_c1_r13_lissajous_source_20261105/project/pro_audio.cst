// Pro C audio-only successor. Reset is Dock S0/K16 active low.
IO_LOC "sys_clk_50m" P16;
IO_PORT "sys_clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "sys_rst_n" K16;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "key_n[0]" F15;
IO_PORT "key_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "key_n[1]" G15;
IO_PORT "key_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "midi_rx" R17;
IO_PORT "midi_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "i2s_bclk" E22;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_lrck" F24;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "i2s_din" G24;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "pa_en" H17;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_tx" P15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ESP32-C3-Zero-M UART1. Dock 4071f3 p16 J26 (PMOD2).
// ESP GPIO4 TX -> J26 pin11 PMOD2_IO0/C21 -> ble_uart_rx.
// ESP GPIO5 RX <- J26 pin9  PMOD2_IO1/B20 <- ble_uart_tx.
// Common ground J26 pin3/4; power ESP independently by USB initially.
IO_LOC "ble_uart_rx" C21;
IO_PORT "ble_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "ble_uart_tx" B20;
IO_PORT "ble_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Dock DVI_TX_A/J11, official Pro CST HDMI port0 pairs (P,N).
IO_LOC "tmds_data_p[0]" AB24,AC24;
IO_LOC "tmds_data_p[1]" V24,W24;
IO_LOC "tmds_data_p[2]" AA22,AA23;
IO_LOC "tmds_clk_p" Y22,Y23;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=6 BANK_VCCIO=3.3;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=6 BANK_VCCIO=3.3;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=6 BANK_VCCIO=3.3;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=6 BANK_VCCIO=3.3;

// R07: dedicate the pixel-clock DVI release FF near its actual serializer
// loads. This exact legal FF site was used in GOWIN_05_R04 with77 loads
// and0.347..1.123ns routes to the same four RESET endpoints. New pixel
// clock/data/recovery/removal timing still requires a full implementation.
INS_LOC "u_score_visual/u_display/dvi_rst_n_s1" R36C180[0][A];

