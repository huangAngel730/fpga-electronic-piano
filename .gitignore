# Gowin project user state.
# The .gprj itself IS tracked: it names the device, the source files and the
# constraints, so it is project source rather than a build product. The .user
# file only stores per-machine window layout and last-opened state.
*.gprj.user

# Tcl driver scripts under code/build/, regenerated on every
# build_electronic_piano.ps1 run, so their content is not project source.
# The ** covers per-project subdirectories such as code/build/probe/.
code/build/**/run_*.tcl

